{
  "name": "devcontour-harness-ui",
  "version": "0.1.0-alpha.11",
  "description": "Read-only operator panel for devcontour-harness: React components and a local standalone app over the harness operator view.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=24.3.0"
  },
  "bin": {
    "devcontour-harness-ui": "dist/lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./model": {
      "types": "./dist/lib/model/index.d.ts",
      "default": "./dist/lib/model/index.js"
    },
    "./styles.css": "./dist/lib/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "prepack": "node scripts/check-deps.mjs && npm run build",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/build-css.mjs && node scripts/copy-assets.mjs && node scripts/prune-components.mjs && vite build --config vite.lib.config.ts && vite build",
    "start": "node dist/lib/cli.js --demo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run format:check && npm test && npm run test:e2e"
  },
  "peerDependencies": {
    "devcontour-harness": ">=0.1.0-alpha.55 <0.2.0",
    "react": "^19.2.9",
    "react-dom": "^19.2.9"
  },
  "peerDependenciesMeta": {
    "devcontour-harness": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/cli": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.13.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.6",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.7",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
